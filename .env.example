# Copy to .env; never commit .env. Generate a unique key using Django secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=reseller
POSTGRES_USER=reseller
POSTGRES_PASSWORD=replace-in-real-env
POSTGRES_SSLMODE=disable
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_VERIFICATION_BASE_URL=http://localhost:8000
EMAIL_VERIFICATION_MAX_AGE=86400
DEFAULT_FROM_EMAIL=noreply@yourdomain.example
SALES_ENABLED=false
FULFILLMENT_ENABLED=false
OPENPROVIDER_BASE_URL=https://api.sandbox.openprovider.nl/v1
OPENPROVIDER_USERNAME=
OPENPROVIDER_PASSWORD=
OPENPROVIDER_CONTACT_ADMIN=
OPENPROVIDER_CONTACT_TECH=
OPENPROVIDER_NS_GROUP=dns-openprovider
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
